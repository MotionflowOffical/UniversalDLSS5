#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "UniversalDLSS5.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,4,3,0
 PRODUCTVERSION 0,4,3,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "MotionflowOffical\0"
            VALUE "FileDescription", "Universal DLSS 5 Neural Rendering Controller\0"
            VALUE "FileVersion", "0.4.3.0\0"
            VALUE "InternalName", "UniversalDLSS5\0"
            VALUE "LegalCopyright", "Copyright 2026 MotionflowOffical\0"
            VALUE "OriginalFilename", "UniversalDLSS5.exe\0"
            VALUE "ProductName", "UniversalDLSS5\0"
            VALUE "ProductVersion", "0.4.3.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
